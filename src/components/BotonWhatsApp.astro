---
import { linkWhatsApp } from '../data/negocio';
import Icono from './Icono.astro';
---

<a
  href={linkWhatsApp()}
  target="_blank"
  rel="noopener"
  data-boton-flotante
  style="bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px)); right: calc(1.25rem + env(safe-area-inset-right, 0px));"
  class="group fixed z-40 flex items-center gap-3 rounded-full bg-[#25D366] p-3.5 font-bold text-[#062f16] shadow-2xl shadow-black/40 transicion-suave duration-500 ease-[var(--ease-salida)] hover:scale-105 hover:bg-[#20bd5a] sm:py-3.5 sm:pl-4 sm:pr-5"
  aria-label="Escribir por WhatsApp"
>
  <span class="relative flex size-7 items-center justify-center">
    <span
      class="absolute inline-flex size-full animate-ping rounded-full bg-white/50 opacity-60"
      aria-hidden="true"></span>
    <Icono nombre="whatsapp" class="relative size-7" />
  </span>
  <span class="hidden text-sm sm:inline">Cotizar por WhatsApp</span>
</a>
