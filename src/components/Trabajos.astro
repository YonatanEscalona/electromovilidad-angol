---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import { linkWhatsApp } from '../data/negocio';
import { rutaLocal } from '../utils/rutas';

import { fotosPortada as trabajos, categoriasPortada as categorias, cantidadFotosInstalaciones } from '../data/proyectos';

---

<section id="trabajos" class="relative py-20 lg:py-28 overflow-hidden">
  <!-- Fondo con iluminación suave de taller sin cuadrícula -->

  <div class="contenedor relative z-10">
    <!-- Encabezado de Sección optimizado SEO + Confianza -->
    <header class="mx-auto max-w-3xl text-center">
      <div class="revelar inline-flex items-center gap-2 rounded-full border border-naranjo-400/30 bg-naranjo-400/10 px-3.5 py-1 text-[11px] font-bold tracking-[0.2em] text-naranjo-400 uppercase">
        <span class="size-1.5 rounded-full bg-naranjo-400 animate-pulse"></span>
        Nuestro Trabajo
      </div>
      
      <h2 class="revelar mt-4 text-[clamp(2rem,4.5vw,3.25rem)] text-white">
        Galería de <span class="text-azul-500">Proyectos</span>
      </h2>
      
      <p class="revelar mx-auto mt-4 max-w-xl text-base text-humo-200/85 sm:text-lg">
        Conoce nuestras instalaciones: cargadores, canalizaciones, conexiones y tableros eléctricos. Fotografías del trabajo en terreno, desde el montaje hasta los detalles del punto de carga.
      </p>
    </header>

    <!-- Filtros Interactivos por Categoría -->
    <nav class="revelar mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Filtrar trabajos por especialidad" data-filtros-galeria>
      {
        categorias.map((cat, idx) => (
          <button
            type="button"
            data-filtro={cat.id}
            class:list={[
              'cursor-pointer rounded-full px-4 py-2 text-xs font-semibold tracking-wide transition-all duration-300 sm:text-sm flex items-center gap-1.5 focus-visible:outline-none',
              idx === 0
                ? 'bg-azul-600 text-navy-950 shadow-lg shadow-black/20 border border-azul-500'
                : 'bg-navy-900/80 text-humo-200/80 border border-white/10 hover:border-naranjo-400/40 hover:text-white hover:bg-navy-800',
            ]}
          >
            <span>{cat.label}</span>
            <span class="inline-block rounded-full bg-white/10 px-1.5 py-0.2 text-[10px] font-bold">
              {cat.conteo}
            </span>
          </button>
        ))
      }
    </nav>

    <!-- Grilla Bento de Trabajos con Modo Inspección -->
    <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5" data-grilla-trabajos>
      {
        trabajos.map((t) => (
          <li
            class:list={[
              'revelar group relative transition-all duration-500',
              t.destacada && 'sm:col-span-2 sm:row-span-2',
            ]}
            data-categoria={t.categoria}
          >
            <button
              type="button"
              class="w-full h-full text-left cursor-pointer focus-visible:ring-2 focus-visible:ring-naranjo-400 focus-visible:outline-none rounded-2xl block"
              data-abrir-modal-trabajo
              data-id={t.id}
              data-titulo={t.titulo}
              data-categoria-label={t.categoriaLabel}
              data-resumen={t.resumen}
              data-tag={t.tag}
              data-src={t.img.src}
              data-alt={t.alt}
              aria-label={`Ver detalle del trabajo: ${t.titulo}`}
            >
              <figure class="tarjeta-borde relative h-full min-h-[260px] sm:min-h-[300px] overflow-hidden rounded-2xl bg-navy-900 group-hover:border-naranjo-400/50 transition-all duration-500 shadow-lg group-hover:shadow-black/20">
                <!-- Imagen real a todo color con zoom suave -->
                <Image
                  src={t.img}
                  alt={t.alt}
                  widths={[400, 700, 1100]}
                  sizes={t.destacada ? "(min-width: 1024px) 700px, (min-width: 640px) 95vw, 95vw" : "(min-width: 1024px) 340px, (min-width: 640px) 50vw, 95vw"}
                  class="absolute inset-0 h-full w-full object-cover transition-all duration-700 group-hover:scale-105"
                  loading="lazy"
                />

                <!-- Gradientes de superposición para legibilidad técnica -->
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/40 to-transparent transition-opacity duration-500 group-hover:opacity-75"
                  aria-hidden="true"
                />

                <!-- Badge superior: Categoría + Botón de Inspección -->
                <div class="absolute inset-x-0 top-0 flex items-center justify-between p-3.5 sm:p-4">
                  <span class="inline-flex items-center gap-1.5 rounded-md border border-white/15 bg-navy-950/80 px-2.5 py-1 text-[10px] sm:text-xs font-semibold tracking-wider text-humo-100 uppercase backdrop-blur-md">
                    <span class="size-1.5 rounded-full bg-naranjo-400" />
                    {t.categoriaLabel}
                  </span>

                  <span class="flex size-7 sm:size-8 items-center justify-center rounded-full border border-white/20 bg-navy-950/80 text-humo-200 transition-all duration-300 group-hover:border-naranjo-400 group-hover:bg-naranjo-400 group-hover:text-navy-950 backdrop-blur-md shadow-md">
                    <Icono nombre="lupa" class="size-3.5 sm:size-4" />
                  </span>
                </div>

                <!-- Pie con información técnica del trabajo -->
                <figcaption class="absolute inset-x-0 bottom-0 flex flex-col justify-end p-4 sm:p-5">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="inline-block rounded border border-naranjo-400/30 bg-naranjo-400/10 px-2 py-0.5 text-[10px] font-mono font-medium text-naranjo-300">
                      {t.tag}
                    </span>
                  </div>

                  <h3 class="text-sm sm:text-base font-bold text-white leading-snug group-hover:text-denim-300 transition-colors duration-300">
                    {t.titulo}
                  </h3>

                  <p class="mt-1 text-xs text-humo-200/75 line-clamp-2 leading-relaxed">
                    {t.resumen}
                  </p>

                  <div class="mt-3 flex items-center gap-1 text-[11px] font-semibold text-naranjo-400 opacity-0 transform translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
                    <span>Inspeccionar fotografía técnica</span>
                    <Icono nombre="flecha" class="size-3" />
                  </div>
                </figcaption>
              </figure>
            </button>
          </li>
        ))
      }
    </ul>

    <!-- Barra de Confianza & Enlace a Galería Completa -->
    <div class="revelar mt-12 flex flex-col lg:flex-row items-center justify-between gap-5 rounded-2xl border border-white/10 bg-navy-900/70 p-5 sm:p-6 backdrop-blur-md">
      <div class="flex items-center gap-3.5 text-left">
        <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-azul-600/20 text-naranjo-400 border border-azul-500/30">
          <Icono nombre="camara" class="size-5" />
        </div>
        <div>
          <p class="text-xs sm:text-sm font-bold text-white flex items-center gap-2">
            <span>Soluciones de electromovilidad</span>
            <span class="rounded bg-naranjo-400/20 px-2 py-0.5 text-[10px] font-bold text-naranjo-400">{cantidadFotosInstalaciones} fotografías</span>
          </p>
          <p class="text-xs text-humo-200/70 mt-0.5">
            Revisa todas las fotografías de nuestras instalaciones en la galería completa.
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto justify-end">
        <a
          href={rutaLocal('/galeria/')}
          class="inline-flex flex-1 sm:flex-initial items-center justify-center gap-2.5 rounded-xl bg-azul-600 hover:bg-azul-500 text-navy-950 px-5 py-3 text-xs sm:text-sm font-bold shadow-lg shadow-black/20 border border-azul-500/80 transition-all duration-300 hover:scale-[1.02] active:scale-98"
        >
          <Icono nombre="video" class="size-4 text-naranjo-300" />
          <span>Ver Galería Completa</span>
          <Icono nombre="flecha" class="size-3.5" />
        </a>

        <a
          href={linkWhatsApp('Hola Soluciones Integrales, vi su galería y quiero cotizar una instalación de carga eléctrica.')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex flex-1 sm:flex-initial items-center justify-center gap-2.5 rounded-xl bg-naranjo-500 px-5 py-3 text-xs sm:text-sm font-bold text-navy-950 hover:bg-naranjo-400 hover:text-navy-950 transition-all duration-300 shadow-lg shadow-black/20 hover:shadow-black/20 hover:scale-[1.02] active:scale-98"
        >
          <Icono nombre="whatsapp" class="size-4 text-navy-950" />
          <span>Cotizar por WhatsApp</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Modal / Lightbox de Inspección Técnica de Fotografías -->
  <div
    id="modal-galeria"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-titulo"
    hidden
  >
    <!-- Fondo oscuro difuminado -->
    <div class="absolute inset-0 bg-navy-950/90 backdrop-blur-xl transition-opacity" data-cerrar-modal />

    <!-- Contenedor del Modal -->
    <div class="tarjeta-borde relative z-10 w-full max-w-3xl overflow-hidden rounded-2xl bg-navy-900 shadow-2xl border border-white/15 transform scale-95 transition-transform duration-300">
      <!-- Botón Cerrar -->
      <button
        type="button"
        class="cursor-pointer absolute top-4 right-4 z-20 flex size-9 items-center justify-center rounded-full bg-navy-950/80 text-white border border-white/20 hover:bg-naranjo-500 hover:text-navy-950 hover:border-naranjo-400 transition-colors focus-visible:ring-2 focus-visible:ring-naranjo-400"
        data-cerrar-modal
        aria-label="Cerrar visor de fotografía"
      >
        <Icono nombre="cerrar" class="size-4" />
      </button>

      <!-- Cuerpo del Modal -->
      <div class="grid grid-cols-1 md:grid-cols-12 max-h-[85vh] overflow-y-auto">
        <!-- Imagen Ampliada -->
        <div class="relative bg-navy-950 md:col-span-7 flex items-center justify-center min-h-[260px] sm:min-h-[360px] p-2">
          <img
            id="modal-imagen"
            src=""
            alt=""
            class="max-h-[55vh] w-full object-contain rounded-lg"
          />
        </div>

        <!-- Ficha Técnica y CTA de Cotización -->
        <div class="flex flex-col justify-between p-6 md:col-span-5 bg-navy-900 border-t md:border-t-0 md:border-l border-white/10">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span id="modal-categoria" class="inline-flex items-center gap-1.5 rounded-md border border-white/15 bg-navy-950 px-2.5 py-1 text-[11px] font-semibold text-naranjo-400 uppercase">
                <!-- JS inserta categoría -->
              </span>
              <span id="modal-tag" class="rounded border border-naranjo-400/30 bg-naranjo-400/10 px-2 py-0.5 text-[10px] font-mono text-naranjo-300">
                <!-- JS inserta tag -->
              </span>
            </div>

            <h3 id="modal-titulo" class="text-lg font-bold text-white leading-snug">
              <!-- JS inserta título -->
            </h3>

            <p id="modal-resumen" class="mt-3 text-xs sm:text-sm text-humo-200/80 leading-relaxed">
              <!-- JS inserta resumen -->
            </p>

          </div>

          <div class="mt-6 pt-4 border-t border-white/10">
            <a
              id="modal-whatsapp-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 rounded-xl bg-azul-600 hover:bg-azul-500 text-navy-950 px-4 py-3 text-xs sm:text-sm font-bold shadow-lg shadow-black/20 transition-all duration-300 active:scale-98"
            >
              <Icono nombre="whatsapp" class="size-4" />
              <span>Cotizar este trabajo por WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function iniciarGaleriaInteractiva() {
    const contenedor = document.getElementById('trabajos');
    if (!contenedor) return;

    // ── 1. FILTRADO POR CATEGORÍA ──────────────────────────────────
    const botonesFiltro = contenedor.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    const tarjetas = contenedor.querySelectorAll<HTMLElement>('[data-grilla-trabajos] > li');

    botonesFiltro.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filtro = btn.dataset.filtro;

        // Actualizar botones
        botonesFiltro.forEach((b) => {
          const activo = b === btn;
          if (activo) {
            b.className = 'cursor-pointer rounded-full px-4 py-2 text-xs font-semibold tracking-wide transition-all duration-300 sm:text-sm flex items-center gap-1.5 focus-visible:outline-none bg-azul-600 text-navy-950 shadow-lg shadow-black/20 border border-azul-500';
          } else {
            b.className = 'cursor-pointer rounded-full px-4 py-2 text-xs font-semibold tracking-wide transition-all duration-300 sm:text-sm flex items-center gap-1.5 focus-visible:outline-none bg-navy-900/80 text-humo-200/80 border border-white/10 hover:border-naranjo-400/40 hover:text-white hover:bg-navy-800';
          }
        });

        // Filtrar tarjetas
        tarjetas.forEach((tarjeta) => {
          const categoria = tarjeta.dataset.categoria;
          const coincide = filtro === 'todos' || categoria === filtro;

          if (coincide) {
            tarjeta.style.display = '';
            setTimeout(() => {
              tarjeta.style.opacity = '1';
              tarjeta.style.transform = 'scale(1)';
            }, 10);
          } else {
            tarjeta.style.opacity = '0';
            tarjeta.style.transform = 'scale(0.95)';
            setTimeout(() => {
              tarjeta.style.display = 'none';
            }, 250);
          }
        });
      });
    });

    // ── 2. MODAL / LIGHTBOX DE INSPECCIÓN ──────────────────────────
    const modal = document.getElementById('modal-galeria');
    const modalImg = document.getElementById('modal-imagen') as HTMLImageElement | null;
    const modalTitulo = document.getElementById('modal-titulo');
    const modalCategoria = document.getElementById('modal-categoria');
    const modalResumen = document.getElementById('modal-resumen');
    const modalTag = document.getElementById('modal-tag');
    const modalWaLink = document.getElementById('modal-whatsapp-link') as HTMLAnchorElement | null;
    const botonesCerrar = contenedor.querySelectorAll('[data-cerrar-modal]');
    const disparadoresModal = contenedor.querySelectorAll<HTMLButtonElement>('[data-abrir-modal-trabajo]');

    if (!modal || !modalImg || !modalTitulo || !modalCategoria || !modalResumen || !modalTag || !modalWaLink) return;

    const abrirModal = (btn: HTMLButtonElement) => {
      const src = btn.dataset.src ?? '';
      const alt = btn.dataset.alt ?? '';
      const titulo = btn.dataset.titulo ?? '';
      const categoriaLabel = btn.dataset.categoriaLabel ?? '';
      const resumen = btn.dataset.resumen ?? '';
      const tag = btn.dataset.tag ?? '';

      modalImg.src = src;
      modalImg.alt = alt;
      modalTitulo.textContent = titulo;
      modalCategoria.textContent = categoriaLabel;
      modalResumen.textContent = resumen;
      modalTag.textContent = tag;

      // Mensaje dinámico de WhatsApp para este trabajo específico
      const textoWa = `Hola Soluciones Integrales, vi en su galería la solución "${titulo}" (${tag}) y me gustaría cotizar una instalación.`;
      modalWaLink.href = `https://wa.me/56935172731?text=${encodeURIComponent(textoWa)}`;

      modal.hidden = false;
      document.body.style.overflow = 'hidden';

      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        const interior = modal.querySelector('.tarjeta-borde');
        interior?.classList.remove('scale-95');
        interior?.classList.add('scale-100');
      });
    };

    const cerrarModal = () => {
      modal.classList.add('opacity-0', 'pointer-events-none');
      const interior = modal.querySelector('.tarjeta-borde');
      interior?.classList.remove('scale-100');
      interior?.classList.add('scale-95');

      setTimeout(() => {
        modal.hidden = true;
        document.body.style.overflow = '';
      }, 300);
    };

    disparadoresModal.forEach((btn) => {
      btn.addEventListener('click', () => abrirModal(btn));
    });

    botonesCerrar.forEach((btn) => {
      btn.addEventListener('click', cerrarModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) {
        cerrarModal();
      }
    });
  }

  // Inicializar al cargar el DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciarGaleriaInteractiva);
  } else {
    iniciarGaleriaInteractiva();
  }
</script>
