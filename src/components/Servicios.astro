---
import { Image } from 'astro:assets';
import { servicios, linkWhatsApp } from '../data/negocio';
import Icono from './Icono.astro';

// Pictogramas SVG originales con siluetas claras y detalles de equipamiento.
import residencial from '../assets/servicios/residencial.svg';
import certificacion from '../assets/servicios/certificacion.svg';
import empresas from '../assets/servicios/empresas.svg';
import balanceo from '../assets/servicios/balanceo.svg';
import empalme from '../assets/servicios/empalme.svg';
import tablero from '../assets/servicios/tablero.svg';
import fotoMecanico from '../assets/electromovilidad/tecnico.webp';
const iconos: Record<string,string> = { residencial:residencial.src, certificacion:certificacion.src, empresas:empresas.src, balanceo:balanceo.src, empalme:empalme.src, tablero:tablero.src };

---

<section id="servicios" class="relative isolate overflow-hidden bg-navy-950">
  <div class="flex flex-col lg:flex-row min-h-0 lg:min-h-screen">
    <!-- Columna izquierda: Panel de contenido (~55% en desktop) -->
    <div
      class="order-2 flex w-full flex-col justify-center px-5 pt-2 pb-12 sm:px-10 sm:pt-4 sm:pb-16 md:px-14 lg:order-1 lg:w-[55%] lg:py-24 lg:pl-12 lg:pr-10 xl:pl-20 xl:pr-16 2xl:pl-28 2xl:pr-20"
    >
      <div class="mx-auto w-full max-w-2xl lg:mx-0 lg:max-w-none">
        <!-- 1. Título h2 (Visible solo en desktop; en móvil se muestra integrado con la foto) -->
        <div class="revelar hidden lg:block pb-2">
          <h2 class="titulo-3d-stack">
            <span class="titulo-3d-sup text-[clamp(1.5rem,2.6vw,2.2rem)]">La energía correcta,</span>
            <span class="titulo-3d-inf text-[clamp(2.3rem,4.4vw,3.7rem)]">donde la necesites</span>
          </h2>
        </div>

        <!-- 2. Párrafo descriptivo -->
        <p class="revelar mt-3 lg:mt-5 max-w-xl text-base leading-relaxed text-humo-200/85 sm:text-lg">
          Diseñamos e instalamos infraestructura de carga adaptada a la realidad eléctrica de cada cliente, desde la obra civil hasta la puesta en marcha.
        </p>

        <!-- 3. Grilla de servicios con iconos agrandados para celular y escritorio -->
        <ul
          class="mt-8 sm:mt-10 grid grid-cols-1 gap-4 sm:gap-x-8 sm:gap-y-9 sm:grid-cols-2"
          data-grilla-servicios
        >
          {
            servicios.map((s) => {
              const src = iconos[s.icono] ?? iconos.residencial;
              return (
                <li class="revelar group relative">
                  {/* Tarjeta interactiva en móvil y desktop */}
                  <div class="flex items-start gap-4 sm:gap-4.5 rounded-2xl border border-white/5 bg-navy-900/60 p-4 transition-all duration-300 group-hover:border-naranjo-400/30 group-hover:bg-navy-900/90 sm:border-white/5 sm:bg-navy-900/30 sm:p-3.5 sm:hover:bg-navy-900/70">
                    {/* SVG en color nativo para conservar contraste, volumen y detalles. */}
                    <div class="mt-0.5 grid size-14 sm:size-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-naranjo-500/20 via-naranjo-500/10 to-navy-800 border border-naranjo-500/30 text-naranjo-400 shadow-md shadow-naranjo-500/10 transition-all duration-300 group-hover:scale-105 group-hover:bg-naranjo-500/25 group-hover:border-naranjo-400/50 group-hover:shadow-naranjo-500/20">
                      <img
                        src={src}
                        width="48"
                        height="48"
                        alt=""
                        class="block size-11 object-contain sm:size-12"
                        loading="lazy"
                        decoding="async"
                        aria-hidden="true"
                      />
                    </div>

                    {/* Textos del servicio (jerarquía clara y alta legibilidad) */}
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between gap-2">
                        <h3 class="font-display text-lg sm:text-xl font-bold text-white tracking-tight transicion-suave duration-300 group-hover:text-naranjo-300">
                          {s.titulo}
                        </h3>
                        {/* Indicador sutil de toque en móvil */}
                        <Icono
                          nombre="flecha"
                          class="size-4 shrink-0 text-naranjo-400/60 opacity-70 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-naranjo-300 sm:hidden"
                        />
                      </div>
                      <p class="mt-1.5 text-sm leading-relaxed text-humo-200/80 sm:text-[15px]">
                        {s.resumen}
                      </p>
                    </div>

                    {/* Enlace clickeable para toda el área del item */}
                    <a
                      href={linkWhatsApp(`Hola, quiero cotizar: ${s.titulo}`)}
                      target="_blank"
                      rel="noopener"
                      class="focus:outline-none"
                      aria-label={`Cotizar ${s.titulo} por WhatsApp`}
                    >
                      <span class="absolute inset-0 z-10" aria-hidden="true" />
                    </a>
                  </div>
                </li>
              );
            })
          }
        </ul>

        <!-- 4. Botón a WhatsApp -->
        <div class="revelar mt-8 sm:mt-12">
          <a
            href={linkWhatsApp()}
            target="_blank"
            rel="noopener"
            class="inline-flex w-full sm:w-auto items-center justify-center gap-3 rounded-full bg-naranjo-500 px-8 py-4 font-display text-base font-extrabold text-white shadow-xl shadow-naranjo-500/25 transicion-suave duration-300 hover:-translate-y-0.5 hover:bg-naranjo-400 hover:text-navy-950"
          >
            <Icono nombre="whatsapp" class="size-5" />
            Solicitar Visita
          </a>
        </div>
      </div>
    </div>

    <!-- Columna derecha: Foto a sangre (~45% en desktop, con título integrado al pie en móvil) -->
    <div
      class="order-1 relative flex flex-col justify-end h-80 sm:h-96 w-full shrink-0 overflow-hidden lg:order-2 lg:h-auto lg:w-[45%]"
    >
      <Image
        src={fotoMecanico}
        alt="Imagen referencial de un técnico instalando infraestructura de carga eléctrica"
        widths={[600, 900, 1400]}
        sizes="(min-width:1024px) 45vw, 100vw"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="lazy"
      />

      <!-- Velo degradado navy para suavizar el corte y dar contraste al título en móvil -->
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/65 to-transparent lg:bg-gradient-to-r lg:from-navy-950 lg:via-navy-950/40 lg:to-transparent"
        aria-hidden="true"
      />

      <!-- Título integrado con la foto en móvil con efecto 3D multicapa -->
      <div class="relative z-10 px-5 pb-5 sm:px-10 sm:pb-8 lg:hidden">
        <h2 class="revelar titulo-3d-stack">
          <span class="titulo-3d-sup text-[clamp(1.3rem,5vw,1.75rem)]">La energía correcta,</span>
          <span class="titulo-3d-inf text-[clamp(1.85rem,7vw,2.5rem)]">donde la necesites</span>
        </h2>
      </div>
    </div>
  </div>
</section>
