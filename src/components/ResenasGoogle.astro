---
import { Image } from 'astro:assets';
import mecanicoImg from '../assets/electromovilidad/profesional-personalizado.webp';
import { negocio, solucionesDestacadas, linkWhatsApp } from '../data/negocio';
import Icono from './Icono.astro';
---

<!--
  `overflow-x: clip` en vez de `hidden`: recorta los halos decorativos que
  se salen por los costados sin cortar al mecánico, que sobresale hacia
  ARRIBA del banner con margen negativo (`hidden` recortaría ambos ejes).
-->
<section id="opiniones" class="relative pt-20 pb-10 sm:pt-28 sm:pb-14 overflow-x-clip">
  <div class="contenedor relative max-w-6xl">
    <!-- ── CONTENEDOR PRINCIPAL DEL BANNER AZUL COBALTO COMPACTO ─── -->
    <div
      class="relative rounded-[2rem] sm:rounded-[2.5rem] border border-azul-500/30 bg-gradient-to-br from-navy-800 via-navy-900 to-navy-950 p-5 sm:p-7 lg:px-9 lg:py-7 shadow-[0_25px_60px_-15px_rgba(23,25,22,0.45)]"
    >
      <!-- Rejilla y luces sutiles de fondo -->
      <div class="rejilla-taller absolute inset-0 opacity-20 mix-blend-overlay rounded-[2rem] sm:rounded-[2.5rem] pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -right-16 -top-16 size-64 rounded-full bg-naranjo-400/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -left-16 -bottom-16 size-64 rounded-full bg-azul-500/20 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <!-- ── FIGURA DEL MECÁNICO SOBRESALIENDO (POP-OUT) ──────────── -->
      <!-- En escritorio: anclado abajo a la izquierda y sobresaliendo por arriba del borde rojo -->
      <div
        class="hidden lg:flex absolute -top-20 xl:-top-24 bottom-0 left-0 xl:left-3 w-[38%] xl:w-[35%] pointer-events-none z-30 items-end justify-center"
        aria-hidden="true"
      >
        <Image
          src={mecanicoImg}
          alt="Técnico eléctrico — imagen referencial"
          widths={[380, 540, 720]}
          sizes="(min-width: 1280px) 35vw, 38vw"
          class="h-auto max-h-[128%] w-auto object-contain object-bottom drop-shadow-[0_20px_25px_rgba(0,0,0,0.65)]"
          loading="eager"
        />
      </div>

      <!-- En móvil y tablet: sobresaliendo por arriba en el centro -->
      <div class="lg:hidden flex justify-center -mt-20 sm:-mt-24 mb-2 relative z-20 pointer-events-none">
        <Image
          src={mecanicoImg}
          alt="Técnico eléctrico — imagen referencial"
          widths={[280, 420, 560]}
          sizes="(min-width: 640px) 320px, 240px"
          class="h-auto max-h-[250px] sm:max-h-[320px] w-auto object-contain object-bottom drop-shadow-[0_15px_20px_rgba(0,0,0,0.65)]"
          loading="eager"
        />
      </div>

      <!-- ── CONTENIDO DERECHA: OPINIONES DE GOOGLE & CARRUSEL ─── -->
      <div class="relative z-20 grid lg:grid-cols-12">
        <!-- Espaciador para la columna del mecánico en escritorio -->
        <div class="hidden lg:block lg:col-span-5 xl:col-span-4"></div>

        <!--
          `min-w-0`: sin esto la columna es un ítem de grilla con mínimo
          automático, así que la pista `auto` crecía hasta el ancho natural
          de la reseña más larga (~1300 px) y estiraba toda la página.
        -->
        <div class="min-w-0 lg:col-span-7 xl:col-span-8 text-left">
          
          <!-- Encabezado / Badge de Google Maps -->
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-black/40 px-3 py-1 backdrop-blur-md">
              <span class="grid size-4 place-items-center rounded-full bg-white p-0.5 shadow-sm">
                <Icono nombre="cargador" class="size-3" />
              </span>
              
              <span class="text-[10px] sm:text-xs font-black tracking-wider text-white uppercase">
                Soluciones Integrales
              </span>
            </div>

            <!-- Ubicación rápida -->
            <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-black/25 px-2.5 py-0.5 text-[11px] font-semibold text-white/90 backdrop-blur-sm">
              <Icono nombre="ubicacion" class="size-3 text-amber-300" />
              {negocio.direccion.calle}
            </span>
          </div>

          <!-- Título Principal Compacto -->
          <h2 class="mt-2.5 font-display text-[clamp(1.5rem,3vw,2.4rem)] font-black tracking-tight text-white uppercase leading-[1.08]">
            Infraestructura de carga segura y certificada
          </h2>

          <p class="mt-1 text-[11px] sm:text-xs font-bold tracking-wide text-white/90 uppercase">
            Hogares y empresas en La Araucanía. Un servicio para cada necesidad.
          </p>

          <!-- ── CARRUSEL INTERACTIVO DE RESEÑAS ──────────────────── -->
          <div class="relative mt-3.5" data-carrusel-google>
            <!-- Contenedor de slides -->
            <div class="overflow-hidden rounded-xl">
              <div class="flex transition-transform duration-500 ease-out" data-carrusel-track>
                {
                  solucionesDestacadas.map((resena, index) => (
                    <div class="w-full shrink-0 px-0.5" data-carrusel-slide={index}>
                      <a
                        href={resena.link}
                        target="_blank"
                        rel="noopener"
                        class="group block relative rounded-xl border border-white/20 bg-black/50 p-4 sm:p-5 backdrop-blur-md transition-all duration-300 hover:border-white/45 hover:bg-black/65 shadow-lg"
                        title="Consultar por esta solución"
                      >
                        <!-- Cabecera de la reseña -->
                        <div class="flex items-start justify-between gap-2">
                          <div class="flex items-center gap-2.5">
                            <span class={`grid size-8 place-items-center rounded-full text-xs font-bold text-navy-950 shadow-md ${'bg-azul-600'}`}>
                              {resena.numero}
                            </span>
                            <div>
                              <div class="flex items-center gap-1.5">
                                <span class="font-display text-xs sm:text-sm font-bold text-white group-hover:text-amber-300 transition-colors">
                                  {resena.titulo}
                                </span>
                                
                              </div>
                              <span class="text-[10px] text-white/60">{'Solución a medida'}</span>
                            </div>
                          </div>

                          <!-- Estrellas + Logo Google -->
                          <div class="flex flex-col items-end gap-0.5">
                            <div class="flex items-center text-amber-300"><Icono nombre="garantia" class="size-4" /></div>
                            <span class="inline-flex items-center gap-1 text-[9px] text-white/60 group-hover:text-white transition-colors">
                              <Icono nombre="cargador" class="size-2.5" />
                              Consultar ↗
                            </span>
                          </div>
                        </div>

                        <!-- Comentario -->
                        <p class="mt-2.5 text-xs sm:text-[13px] leading-relaxed text-white/90 font-medium">
                          {resena.texto}
                        </p>

                        <!-- Servicio realizado -->
                        <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-2 text-[11px]">
                          <span class="inline-flex items-center gap-1 font-bold text-amber-300">
                            <Icono nombre="check" class="size-3 text-emerald-400" />
                            <span>Servicio: {resena.etiqueta}</span>
                          </span>
                          <span class="text-[10px] font-semibold text-white/70 group-hover:text-white underline underline-offset-2">
                            Consultar ↗
                          </span>
                        </div>
                      </a>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Controles del Carrusel (Flechas y Puntos) -->
            <div class="mt-3 flex items-center justify-between">
              <!-- Paginación con puntos -->
              <!--
                El punto visible mide 8 px, pero el botón que lo envuelve
                mide 24 px: es el mínimo táctil accesible (WCAG 2.5.8) y
                evita fallar el toque en pantallas chicas.
              -->
              <div class="-ml-1.5 flex items-center" data-carrusel-dots>
                {
                  solucionesDestacadas.map((_, i) => (
                    <button
                      type="button"
                      class="grid size-6 shrink-0 place-items-center rounded-full"
                      data-carrusel-dot={i}
                      aria-label={`Ir a la solución ${i + 1}`}
                      aria-current={i === 0 ? 'true' : undefined}
                    >
                      <span
                        class="block h-2 rounded-full transition-all duration-300"
                        class:list={[i === 0 ? 'w-5 bg-white' : 'w-2 bg-white/35']}
                        aria-hidden="true"
                      />
                    </button>
                  ))
                }
              </div>

              <!-- Flechas de navegación compactas -->
              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  data-carrusel-prev
                  class="grid size-7 place-items-center rounded-full border border-white/20 bg-black/40 text-white backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-black/70 hover:border-white/50 active:scale-95"
                  aria-label="Solución anterior"
                >
                  <Icono nombre="flecha" class="size-3 rotate-180" />
                </button>
                <button
                  type="button"
                  data-carrusel-next
                  class="grid size-7 place-items-center rounded-full border border-white/20 bg-black/40 text-white backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-black/70 hover:border-white/50 active:scale-95"
                  aria-label="Siguiente solución"
                >
                  <Icono nombre="flecha" class="size-3" />
                </button>
              </div>
            </div>
          </div>

          <!-- ── BOTÓN ÚNICO NEGRO DE WHATSAPP (IDÉNTICO A LA REFERENCIA) ── -->
          <div class="mt-4 pt-1">
            <a
              href={linkWhatsApp('Hola Soluciones Integrales, quiero solicitar una visita técnica para instalar un cargador eléctrico.')}
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center justify-center gap-2.5 rounded-full bg-black px-6 py-3 font-display text-xs sm:text-sm font-black tracking-wider text-white uppercase shadow-xl transition-all duration-300 hover:scale-[1.02] hover:bg-navy-900 active:scale-95 border border-white/15"
            >
              <Icono nombre="whatsapp" class="size-4 text-emerald-400 transition-transform duration-300 group-hover:scale-110" />
              <span>Solicitar Visita por WhatsApp</span>
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function iniciarCarruselGoogle() {
    const contenedor = document.querySelector<HTMLElement>('[data-carrusel-google]');
    if (!contenedor) return;

    const track = contenedor.querySelector<HTMLElement>('[data-carrusel-track]');
    const slides = contenedor.querySelectorAll<HTMLElement>('[data-carrusel-slide]');
    const dots = contenedor.querySelectorAll<HTMLButtonElement>('[data-carrusel-dot]');
    const btnPrev = contenedor.querySelector<HTMLButtonElement>('[data-carrusel-prev]');
    const btnNext = contenedor.querySelector<HTMLButtonElement>('[data-carrusel-next]');

    if (!track || slides.length === 0) return;
    const trackEl: HTMLElement = track;

    let indexActual = 0;
    const total = slides.length;
    let intervalo: ReturnType<typeof setInterval> | null = null;

    function irA(index: number) {
      indexActual = (index + total) % total;
      trackEl.style.transform = `translateX(-${indexActual * 100}%)`;

      // Actualizar dots: el botón es el área táctil, el <span> es el punto visible
      dots.forEach((dot, i) => {
        const activo = i === indexActual;
        const punto = dot.firstElementChild as HTMLElement | null;
        if (punto) {
          punto.className = activo
            ? 'block h-2 rounded-full transition-all duration-300 w-5 bg-white'
            : 'block h-2 rounded-full transition-all duration-300 w-2 bg-white/35';
        }
        if (activo) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }

    function siguiente() {
      irA(indexActual + 1);
    }

    function anterior() {
      irA(indexActual - 1);
    }

    function iniciarAutoPlay() {
      detenerAutoPlay();
      intervalo = setInterval(siguiente, 4500);
    }

    function detenerAutoPlay() {
      if (intervalo) {
        clearInterval(intervalo);
        intervalo = null;
      }
    }

    // Event listeners
    btnNext?.addEventListener('click', () => {
      siguiente();
      iniciarAutoPlay();
    });

    btnPrev?.addEventListener('click', () => {
      anterior();
      iniciarAutoPlay();
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        irA(i);
        iniciarAutoPlay();
      });
    });

    // Pausar al pasar el cursor o interactuar
    contenedor.addEventListener('mouseenter', detenerAutoPlay);
    contenedor.addEventListener('mouseleave', iniciarAutoPlay);
    contenedor.addEventListener('touchstart', detenerAutoPlay, { passive: true });
    contenedor.addEventListener('touchend', iniciarAutoPlay, { passive: true });

    iniciarAutoPlay();
  }

  // Ejecutar al cargar la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciarCarruselGoogle);
  } else {
    iniciarCarruselGoogle();
  }
</script>
